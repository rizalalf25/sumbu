# Produksi: isi melalui pengaturan hosting, bukan dengan menyimpan secret ke Git.
# DATABASE_URL=postgresql://...
# BETTER_AUTH_SECRET=secret-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:8080

# Tanpa DATABASE_URL, npm run dev memakai .data/sumbu pada komputer ini.
# SUMBU_ALLOW_LOCAL_DB=true hanya untuk menguji build lokal; jangan set di hosting.
